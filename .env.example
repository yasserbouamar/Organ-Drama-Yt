# Only for `npm run voiceover:elevenlabs` (optional; the default voiceover is offline Kokoro).
ELEVENLABS_API_KEY=

# Optional per-speaker voice overrides (ElevenLabs voice IDs).
# ELEVENLABS_VOICE_HOST=
# ELEVENLABS_VOICE_ROCKET=
# ELEVENLABS_VOICE_LIL_SAT=
# ELEVENLABS_VOICE_SUN=
# ELEVENLABS_VOICE_GRAVITY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
