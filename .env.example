# ELEVENLABS_VOICE_HOST=
# ELEVENLABS_VOICE_ROCKET=
# ELEVENLABS_VOICE_LIL_SAT=
# ELEVENLABS_VOICE_SUN=
# ELEVENLABS_VOICE_GRAVITY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
