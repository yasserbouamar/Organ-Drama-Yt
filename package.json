    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
