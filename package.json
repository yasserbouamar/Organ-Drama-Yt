{
  "name": "cosmic-eviction",
  "version": "1.0.0",
  "description": "Cosmic Eviction (60s Pilot) — a comic-pop science explainer built with Remotion",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render CosmicEvictionPilot out/cosmic-eviction-pilot.mp4",
    "render:draft": "remotion render CosmicEvictionPilot out/cosmic-eviction-pilot-draft.mp4 --scale=0.5",
    "stills": "remotion still CosmicEvictionPilot out/still.png --frame=120",
    "typecheck": "tsc --noEmit",
    "voiceover": "tsx scripts/generate-voiceover.ts"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@remotion/cli": "4.0.528",
