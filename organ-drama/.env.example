# Optional: ElevenLabs voices for `npm run audio`.
# Without a key the generator falls back to edge-tts, then offline Kokoro, then procedural babble.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional per-speaker voice overrides (ElevenLabs voice IDs).
# ELEVENLABS_VOICE_NARRATOR=
# ELEVENLABS_VOICE_BRAIN=
# ELEVENLABS_VOICE_STOMACH=
# ELEVENLABS_VOICE_LETTER=
# ELEVENLABS_VOICE_HEART=
# ELEVENLABS_VOICE_PIZZA=
