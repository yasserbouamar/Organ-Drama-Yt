{
  "name": "organ-drama",
  "version": "1.0.0",
  "description": "Organ Drama: Midnight Pizza — a 60-second animated health explainer built with Remotion",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render OrganDramaPilot out/organ-drama-midnight-pizza.mp4",
    "render:draft": "remotion render OrganDramaPilot out/organ-drama-draft.mp4 --scale=0.5",
    "render:remake": "remotion render ReferenceRemake out/reference-remake.mp4",
    "stills": "remotion still OrganDramaPilot out/still.png --frame=150",
    "typecheck": "tsc --noEmit",
    "audio": "tsx scripts/generate-audio.ts",
    "episode": "tsx scripts/episode.ts",
    "audio:kokoro-setup": "python3 -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/luckiest-guy": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@remotion/bundler": "4.0.528",
    "@remotion/cli": "4.0.528",
    "@remotion/fonts": "4.0.528",
    "@remotion/media-utils": "4.0.528",
    "@remotion/renderer": "4.0.528",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
